{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "NixOS",
  },

  "display": {
    "separator": " ",
  },

  "modules": [
    "break",
    "break",
    {
      "type": "title",
      "keyWidth": 12,
      "color": "blue",
    },
    "break",
    {
      "type": "os",
      "key": " ",
      "keyColor": "blue",
      "color": "blue",
      "format": "HyprNix",
    },
    {
      "type": "packages",
      "key": "󰏖 ",
      "keyColor": "blue",
      "color": "blue",
      "format": "{nix-all} ( {flatpak-all})",
    },
    {
      "type": "host",
      "key": "🖥 ",
      "keyColor": "blue",
      "color": "blue",
      "format": "My PC",
    },
    {
      "type": "shell",
      "format": "zsh",
      "key": ">_",
      "keyColor": "blue",
      "color": "blue",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "blue",
      "color": "blue",
    },
    {
      "type": "terminalfont",
      "key": "",
      "keyColor": "blue",
      "color": "blue",
    },
    {
      "type": "wm",
      "format": "{}",
      "key": " ",
      "keyColor": "blue",
      "color": "blue",
    },
    {
      "type": "cpu",
      "key": "󰍛 ",
      "keyColor": "blue",
      "color": "blue",
      "format": "",
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "blue",
      "color": "blue",
      "format": "",
    },
    {
      "type": "memory",
      "key": "🎟 ",
      "keyColor": "blue",
      "color": "blue",
      "format": "{} {}",
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "blue",
      "color": "blue",
    },
    "break",
    "break",
    "break",
  ],
}
