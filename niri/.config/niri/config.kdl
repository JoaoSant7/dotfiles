include "noctalia.kdl"

include "input.kdl"
include "outputs.kdl"
include "layout.kdl"
include "bindings/apps.kdl"
include "bindings/noct-calls.kdl"
include "bindings/tiling.kdl"
include "animations.kdl"
include "window-rules.kdl"
include "env.kdl"

spawn-at-startup "kanshi"
spawn-at-startup "noctalia"
