binds {
    // Window switcher
    Alt+Tab { spawn "noctalia" "msg" "window-switcher"; }

    // Panels and settings
    Mod+A { spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications"; }
    Mod+Z { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+X { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+D { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Shift+W { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    // Screenshot
    Mod+R { spawn "noctalia" "msg" "screenshot-region"; }

    // Night light
    Mod+N { spawn "noctalia" "msg" "nightlight-enable"; }
    Mod+Alt+N { spawn "noctalia" "msg" "nightlight-disable"; }

    // Session
    Mod+Alt+C { spawn "noctalia" "msg" "panel-toggle" "session"; }

    // Sound
    XF86AudioRaiseVolume { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute { spawn "noctalia" "msg" "volume-mute"; }

    // Brightness
    XF86MonBrightnessUp { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown { spawn "noctalia" "msg" "brightness-down"; }
}
