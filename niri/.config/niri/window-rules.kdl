// Debug
debug {
  honor-xdg-activation-with-invalid-serial
  wait-for-frame-completion-before-queueing
}

// Corners
window-rule {
  geometry-corner-radius 10

  // Clips window contents to the rounded corner boundaries.
  clip-to-geometry true
  draw-border-with-background false
}

// Maximized windows
window-rule {
    match app-id="brave-origin"
    match app-id="kitty"
    open-maximized true
}

window-rule {
    match app-id=r#"^dfr\.floating\.thunar$"#

    open-floating true
    default-column-width { proportion 0.33; }
    default-window-height { proportion 0.5; }
}


// Floating Noctalia settings window.
window-rule {
  match app-id="dev.noctalia.Noctalia"
  open-floating true
  default-column-width { proportion 0.5; }
  default-window-height { proportion 0.9; }
}

window-rule {
    match app-id=r#"^Pinentry-gtk$"#
    match app-id=r#"^mpv$"#
    match app-id=r#"^thunar$"# title=r#"^Rename "#
    match app-id=r#"^org\.gnome\.FileRoller$"# title="^Extract"
    match app-id=r#"firefox$"# title=r#"^(Picture-in-Picture|Library|About Mozilla Firefox|Firefox - Choose a profile)$"#

    open-floating true
}

// Open KDE Connect as a small floating windows.
window-rule {
	match app-id="org.kde.kdeconnect.app"
  match app-id="org.localsend.localsend_app"

	open-floating true
	default-column-width { proportion 0.3; }
	default-window-height { proportion 0.7; }
}
